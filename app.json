{
  "expo": {
    "name": "حاسبة مولدات سوريا",
    "slug": "syrian-generator-calc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#CE1126"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syriangenerator.calculator"
    },
    "android": {
      "package": "com.syrian.generatorcalc",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#007A3D"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "حاسبة مولدات سوريا",
      "shortName": "مولدات",
      "description": "حاسبة أحمال المولدات الكهربائية وتكاليف اليوم واستهلاك السوق السورية",
      "themeColor": "#007A3D",
      "backgroundColor": "#1a1a1a",
      "startUrl": "/",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "ar"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
