{
  "expo": {
    "name": "حاسبة المولدات السورية",
    "slug": "syrian-generator-calc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "syrian-generator-calc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#CE1126"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.syriangenerator.calculator"
    },
    "android": {
      "package": "com.syrian.generatorcalc",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#007A3D"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "حاسبة مولدات سوريا",
      "shortName": "حاسبة مولدات",
      "description": "حاسبة أحمال المولدات الكهربائية، التكاليف اليومية، واستهلاك الديزل للسوق السوري",
      "themeColor": "#007A3D",
      "backgroundColor": "#1a1a1a",
      "startUrl": "/",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "ar"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
